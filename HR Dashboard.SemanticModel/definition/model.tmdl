/// HR analytics star schema: monthly employee snapshot fact with conformed dimensions for date, organisation and demographics.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Source File Path","HR_Data"]

ref table HR_Data
ref table _measures

ref cultureInfo en-US

