	/// Attrition across all departments, other filters kept. Reference line on the department chart.
	measure 'Attrition Rate Company Avg' = CALCULATE ( [Attrition Rate], REMOVEFILTERS ( HR_Data[Department] ) )
		formatString: 0.0%
		displayFolder: 1. Workforce
		lineageTag: 695f3975-c3dd-41d0-a8d7-3ba37c8c305f

	/// Red above company average, green otherwise.
	measure 'Attrition Bar Color' = IF ( [Attrition Rate] > [Attrition Rate Company Avg], "#D8211D", "#008E60" )
		isHidden
		displayFolder: 1. Workforce\Formatting
		lineageTag: 0ef19f8b-7aff-4f21-a538-dec110d1c5f1

	/// Subtitle for the exit reasons chart.
	measure 'Exit Type Summary' =
			VAR _vol = CALCULATE ( [Exits], HR_Data[Exit_Type] = "Voluntary" )
			VAR _inv = CALCULATE ( [Exits], HR_Data[Exit_Type] = "Involuntary" )
			VAR _tot = _vol + _inv
			RETURN
			    FORMAT ( _tot, "#,0" ) & " exits · Voluntary " & FORMAT ( _vol, "#,0" ) & " (" & FORMAT ( DIVIDE ( _vol, _tot ), "0%" ) & ") · Involuntary "
			        & FORMAT ( _inv, "#,0" ) & " (" & FORMAT ( DIVIDE ( _inv, _tot ), "0%" ) & ")"
		displayFolder: 1. Workforce\Formatting
		lineageTag: 2ae62d28-e075-4b05-965d-4065c867169d

	/// Subtitle for the gender split chart.
	measure 'Gender Subtitle' = "Active employees as of " & FORMAT ( DATE ( 1899, 12, 30 ) + MAX ( HR_Data[Snapshot_Month] ), "mmm yyyy" )
		displayFolder: 1. Workforce\Formatting
		lineageTag: 5de37e5d-b644-4fa9-9cad-18e1537df4bd

	/// Share of end-of-period headcount in each performance rating.
	measure 'Employees % of Total' = DIVIDE ( [Headcount], CALCULATE ( [Headcount], REMOVEFILTERS ( HR_Data[Performance_Rating], HR_Data[Rating Label] ) ) )
		formatString: 0.0%
		displayFolder: 2. Pay & Performance
		lineageTag: 4cbfaa17-2ac3-42e4-ad4c-7a0bf629dc19

	/// Subtitle for the rating distribution chart.
	measure 'Rating Subtitle' = "% of active employees as of " & FORMAT ( DATE ( 1899, 12, 30 ) + MAX ( HR_Data[Snapshot_Month] ), "mmm yyyy" )
		displayFolder: 2. Pay & Performance\Formatting
		lineageTag: 79088b0d-7c38-45db-bded-ef356c3b5d22

	/// Red for ratings 1-2, grey for 3, green for 4-5.
	measure 'Rating Bar Color' =
			VAR _rating = SELECTEDVALUE ( HR_Data[Performance_Rating] )
			RETURN
			    SWITCH ( TRUE (), _rating <= 2, "#D8211D", _rating = 3, "#BFBFBF", "#008E60" )
		isHidden
		displayFolder: 2. Pay & Performance\Formatting
		lineageTag: c4368dd6-d898-4647-bb40-b37135e189de

	column Column
		formatString: 0
		lineageTag: 138b1a4d-1cde-421f-91a0-79d65fec47ea
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _measures = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 882f3cc294ce4bbe98623381f33d6a94

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

