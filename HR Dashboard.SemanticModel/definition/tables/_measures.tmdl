table _measures
	lineageTag: dbc6341b-614a-4ffe-910c-9f254c46e5e7

	/// Active employees in the latest month of the selected period (end-of-period headcount).
	measure Headcount =
			VAR _lastMonth = MAX ( HR_Data[Snapshot_Month] )
			RETURN
			    CALCULATE ( COUNTROWS ( HR_Data ), HR_Data[Snapshot_Month] = _lastMonth )
		formatString: #,##0
		displayFolder: 1. Workforce
		lineageTag: c814ed3c-e4ba-4eb6-80a7-8325420421bd

	/// Employees who joined during the selected period.
	measure 'New Hires' = CALCULATE ( COUNTROWS ( HR_Data ), HR_Data[New_Hire_Flag] = 1 )
		formatString: #,##0
		displayFolder: 1. Workforce
		lineageTag: 70e73989-dcaa-4a49-954a-801cba575b35

	/// Employees who left during the selected period.
	measure Exits = CALCULATE ( COUNTROWS ( HR_Data ), HR_Data[Exit_Flag] = 1 )
		formatString: #,##0
		displayFolder: 1. Workforce
		lineageTag: 9145a24c-ddd9-43c4-a1b4-d87a7b1b2986

	/// New hires minus exits.
	measure 'Net Change' = [New Hires] - [Exits]
		formatString: +#,##0;-#,##0;0
		displayFolder: 1. Workforce
		lineageTag: bd441741-8406-4f9d-960d-8c4c0ec0d219

	/// Average monthly headcount across the months in the selected period.
	measure 'Avg Monthly Headcount' = AVERAGEX ( VALUES ( HR_Data[Snapshot_Month] ), CALCULATE ( COUNTROWS ( HR_Data ) ) )
		formatString: #,##0
		displayFolder: 1. Workforce
		lineageTag: f01937f6-0818-4b6d-9109-d5cd99339c8c

	/// Exits divided by average monthly headcount for the selected period.
	measure 'Attrition Rate' = DIVIDE ( [Exits], [Avg Monthly Headcount] )
		formatString: 0.0%
		displayFolder: 1. Workforce
		lineageTag: 85831165-63fa-416d-ae58-0a6e4fc70b6a

	/// Average unplanned absence days per employee per month.
	measure 'Avg Absence Days' = AVERAGE ( HR_Data[Absence_Days] )
		formatString: 0.00
		displayFolder: 1. Workforce
		lineageTag: 5f5a9df2-2931-4b0e-8ead-bc2ae5bc0cdf

	/// Average monthly engagement score (1-5).
	measure 'Avg Engagement Score' = AVERAGE ( HR_Data[Engagement_Score] )
		formatString: 0.00
		displayFolder: 1. Workforce
		lineageTag: 5e2a83c5-090c-43e2-90fd-b3a15840ba8e

	/// Average base monthly salary in MYR.
	measure 'Avg Monthly Salary' = AVERAGE ( HR_Data[Monthly_Salary_MYR] )
		formatString: "MYR" #,##0
		displayFolder: 2. Pay & Performance
		lineageTag: e9d4e5de-418b-4088-82bb-4ef27c0e6e13

	/// Average performance rating (1-5).
	measure 'Avg Performance Rating' = AVERAGE ( HR_Data[Performance_Rating] )
		formatString: 0.00
		displayFolder: 2. Pay & Performance
		lineageTag: 36ae45ef-e441-488c-8503-27f79d6cf9e7

	/// Average training hours per employee per month.
	measure 'Avg Training Hours' = AVERAGE ( HR_Data[Training_Hours] )
		formatString: 0.00
		displayFolder: 2. Pay & Performance
		lineageTag: 79a09476-0269-4b60-ad31-1ae51894cb94

	/// Average overtime hours per employee per month.
	measure 'Avg Overtime Hours' = AVERAGE ( HR_Data[Overtime_Hours] )
		formatString: 0.00
		displayFolder: 2. Pay & Performance
		lineageTag: f42ebbd9-9c00-4c73-a746-1e635a7de3f7

	/// Headcount for the same months one year earlier.
	measure 'Headcount PY' =
			VAR _pyMonths =
			    SELECTCOLUMNS (
			        VALUES ( HR_Data[Snapshot_Month] ),
			        "PY Month", INT ( EDATE ( DATE ( 1899, 12, 30 ) + HR_Data[Snapshot_Month], -12 ) - DATE ( 1899, 12, 30 ) )
			    )
			RETURN
			    CALCULATE (
			        [Headcount],
			        REMOVEFILTERS ( HR_Data[Year], HR_Data[Month], HR_Data[Month No], HR_Data[Snapshot_Month], HR_Data[Year Month], HR_Data[Year Quarter], HR_Data[Year Quarter No] ),
			        TREATAS ( _pyMonths, HR_Data[Snapshot_Month] )
			    )
		formatString: #,##0
		displayFolder: 1. Workforce\Previous Year
		lineageTag: be4697de-cd85-40cd-b0c3-16b448553efc

	/// KPI card caption: previous-year value for Headcount.
	measure 'Headcount PY Label' =
			VAR _py = [Headcount PY]
			RETURN
			    "As of " & FORMAT ( DATE ( 1899, 12, 30 ) + MAX ( HR_Data[Snapshot_Month] ), "mmm yyyy" ) & " · " & "Previous Year: " & IF ( ISBLANK ( _py ), "n/a", FORMAT ( _py, "#,##0" ) )
		displayFolder: 1. Workforce\KPI Labels
		lineageTag: da583bf2-efbf-46bc-a6a0-2b1585e5c0bf

	/// KPI card delta vs previous year for Headcount.
	measure 'Headcount Change Label' =
			VAR _cur = [Headcount]
			VAR _py = [Headcount PY]
			VAR _chg = DIVIDE ( _cur - _py, _py )
			RETURN
			    IF ( ISBLANK ( _py ) || ISBLANK ( _cur ), BLANK (), IF ( _chg > 0, "▲ ", IF ( _chg < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( _chg ), "0.0%" ) )
		displayFolder: 1. Workforce\KPI Labels
		lineageTag: 4d28ef3e-5651-4f71-b4d5-d59335204939

	/// Green when the change is favourable, red when not.
	measure 'Headcount Change Color' =
			VAR _cur = [Headcount]
			VAR _py = [Headcount PY]
			RETURN
			    IF ( ISBLANK ( _py ) || ISBLANK ( _cur ), "#8C8C8C", IF ( _cur >= _py, "#008E60", "#D8211D" ) )
		isHidden
		displayFolder: 1. Workforce\KPI Labels
		lineageTag: 411b5c00-d67d-4ae3-9968-c9d0dd61711b

	/// Attrition Rate for the same months one year earlier.
	measure 'Attrition Rate PY' =
			VAR _pyMonths =
			    SELECTCOLUMNS (
			        VALUES ( HR_Data[Snapshot_Month] ),
			        "PY Month", INT ( EDATE ( DATE ( 1899, 12, 30 ) + HR_Data[Snapshot_Month], -12 ) - DATE ( 1899, 12, 30 ) )
			    )
			RETURN
			    CALCULATE (
			        [Attrition Rate],
			        REMOVEFILTERS ( HR_Data[Year], HR_Data[Month], HR_Data[Month No], HR_Data[Snapshot_Month], HR_Data[Year Month], HR_Data[Year Quarter], HR_Data[Year Quarter No] ),
			        TREATAS ( _pyMonths, HR_Data[Snapshot_Month] )
			    )
		formatString: 0.0%
		displayFolder: 1. Workforce\Previous Year
		lineageTag: ebc15592-77d4-43d6-bf42-e699c78db01e

	/// KPI card caption: previous-year value for Attrition Rate.
	measure 'Attrition Rate PY Label' =
			VAR _py = [Attrition Rate PY]
			RETURN
			    "Previous Year: " & IF ( ISBLANK ( _py ), "n/a", FORMAT ( _py, "0.0%" ) )
		displayFolder: 1. Workforce\KPI Labels
		lineageTag: c2e8764f-54a7-4481-92c6-b624e958192c

	/// KPI card delta vs previous year for Attrition Rate.
	measure 'Attrition Rate Change Label' =
			VAR _cur = [Attrition Rate]
			VAR _py = [Attrition Rate PY]
			VAR _chg = ( _cur - _py ) * 100
			RETURN
			    IF ( ISBLANK ( _py ) || ISBLANK ( _cur ), BLANK (), IF ( _chg > 0, "▲ ", IF ( _chg < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( _chg ), "0.0" ) & " pts" )
		displayFolder: 1. Workforce\KPI Labels
		lineageTag: 74702a28-e3b0-4c15-9296-0ff2b9596b07

	/// Green when the change is favourable, red when not (lower is better).
	measure 'Attrition Rate Change Color' =
			VAR _cur = [Attrition Rate]
			VAR _py = [Attrition Rate PY]
			RETURN
			    IF ( ISBLANK ( _py ) || ISBLANK ( _cur ), "#8C8C8C", IF ( _cur <= _py, "#008E60", "#D8211D" ) )
		isHidden
		displayFolder: 1. Workforce\KPI Labels
		lineageTag: e3df9e8b-3de4-4be8-a3e8-39c696118709

